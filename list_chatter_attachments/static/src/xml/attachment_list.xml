<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="mail.AttachmentList" t-inherit-mode="extension">
        
        <xpath expr="//div[contains(@class, 'o-mail-AttachmentList')]/div[contains(@class, 'd-flex')]" position="attributes">
            <attribute name="t-att-class">{
                'justify-content-end': isInChatWindowAndIsAlignedRight and !env.inComposer,
                'o-attachment-list-view flex-column w-100': props.attachments.length > 4,
                'flex-wrap gap-2': props.attachments.length &lt;= 4
            }</attribute>
        </xpath>

        <xpath expr="//div[contains(@class, 'o-mail-Attachment-hover')]//div[contains(@class, 'd-flex flex-row')]" position="replace">
            <div class="d-flex flex-row align-items-center gap-2" style="flex-grow: 1; overflow: hidden;">
                
                <t t-if="attachment.isImage">
                    <img src="/mail/static/src/img/image_icon.png" class="mw-100 mh-100 rounded o-mt-0_5" draggable="false"/>
                </t>
                <t t-else="">
                    <div class="o-mail-Attachment-hover-image o_image flex-shrink-0" t-att-data-mimetype="attachment.mimetype"/>
                </t>
                
                <div class="d-flex flex-column justify-content-center overflow-hidden" style="flex-grow: 1;">
                    <div t-if="attachment.name" class="o-mail-Attachment-hoverImageText fw-bold text-truncate" t-out="props.messageSearch?.highlight(attachment.name) ?? attachment.name"/>
                    
                    <div t-if="props.attachments.length > 4" class="d-flex align-items-center o_attachment_meta gap-2">
                        <span t-if="attachment.create_date" t-out="attachment.create_date.toString().substring(0, 10)"/>
                        <span t-if="attachment.create_date &amp;&amp; attachment.file_size">•</span>
                        <span t-if="attachment.file_size"><t t-out="Math.round(attachment.file_size / 1024, 2)"/> KB</span>
                    </div>
                </div>

            </div>
        </xpath>
        
        <xpath expr="//div[contains(@class, 'o-mail-Attachment-hover')]/div[contains(@class, 'ms-4')]" position="replace"/>

    </t>

</templates>